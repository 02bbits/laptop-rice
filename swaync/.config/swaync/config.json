{
  "$schema": "/etc/xdg/swaync/configSchema.json",
  "positionX": "center",
  "positionY": "top",
  "layer": "overlay",
  "control-center-layer": "top",
  "layer-shell": true,
  "cssPriority": "application",
  "control-center-width": 350,
  "control-center-height": 600,
  "control-center-margin-top": 0,
  "control-center-margin-bottom": 500,
    "cssPriority" : "user",
  "control-center-margin-right": 0,
  "control-center-margin-left": 800,
  "notification-2fa-action": true,
  "notification-inline-replies": false,
  "notification-window-width": 380,
  "notification-icon-size": 48,
  "notification-body-image-height": 240,
  "notification-body-image-width": 240,
  "timeout": 8,
  "timeout-low": 4,
  "timeout-critical": 0,
  "fit-to-screen": true,
  "keyboard-shortcuts": true,
  "image-visibility": "when-available",
  "transition-time": 150,
  "hide-on-clear": true,
  "hide-on-action": true,
  "script-fail-notify": true,
    "widgets": [
        "buttons-grid",
        "mpris",
        "dnd",
        "volume",
        "backlight",
        "title",
        "notifications"
    ],
    "widget-config": {
        "title": {
            "text": "Notifications",
            "clear-all-button": true,
            "button-text": " clear"
        },
        "notifications": {
            "vexpand": false
        },
        "inhibitors": {
            "text": "Inhibitors",
            "button-text": "Clear All",
            "clear-all-button": true
        },
        "dnd": {
            "text": "Do Not Disturb"
        },
        "backlight": {
            "label": "󱎴",
            "device": "intel_backlight",
            "min": 10
        },
        "backlight#KB": {
            "label": " ",
            "device": "asus::kbd_backlight",
            "subsystem": "leds"
        },
            "volume": {
            "label": ""
        },
        "label": {
            "max-lines": 1,
            "text": "Control Center"
        },
        "mpris": {
			"autohide": true,
			"show-album-art": "always",
			"loop-carousel": false
        },
        "buttons-grid": {
            "actions": [
                {
                    "label": " ",
                    "command": "nm-connection-editor"
                },
                {
                    "label": "",
                    "command": "blueman-manager"
                },
                {
                    "label": "",
                    "command": "sh $HOME/.config/scripts/waybar/toggle_mic.sh"
                },
                {
                    "label": "󰈐",
                    "command": "sh $HOME/.config/scripts/system/rog-change-mode.sh"
                }
            ]
        }
    }
}
