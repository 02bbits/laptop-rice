{
    "include": "~/.config/waybar/modules.jsonc",
    "reload_style_on_change": true,

    // Horizontal bar. Vertical variant lives in vertical-bar.jsonc.
    "width": 1000,
    "height": 45,
    "spacing": 10,
    "margin-top": 8,
    "margin-bottom": 7,

    // identity, then machine telemetry
    "modules-left": [
        "custom/username",
        "group/system-info"      // custom/seperator-right, cpu, memory, disk
    ],

    // workspaces alone, so the centre stays the centre
    "modules-center": [
        // "group/info",
        "niri/workspaces#word",
        "group/utils"
    ],

    // ambient -> connectivity -> power -> alerts -> time
    "modules-right": [
        "group/system",          // custom/seperator-left, network, pulseaudio, power-profiles-daemon
        "battery",
        "custom/notifications",
        "clock"
    ]
}
