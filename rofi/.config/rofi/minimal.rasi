/* Minimal — Ink, with input. Same look as command-palette.rasi: search bar, rows, key hints.
   Scripts tweak it with -theme-str (width, placeholder, layout); one quoted value per -theme-str. */
@theme "theme.rasi"

configuration {
    sort: true;
    modi:                "drun";
    show-icons:          false;
    display-drun:        "";
    text-color:       @accent;
    drun-display-format: "{icon} {name}";
    font:                "FiraCode Nerd Font 12";
    terminal:            "/usr/bin/ghostty";
}

window {
    width:            440px;
    location:         north;
    anchor:           north;
    y-offset:         8px;
    border:           1px;
    border-color:     @border-colour;
    border-radius:    16px;
    background-color: @background;
}

/*****----- Message (shown only when a script passes -mesg) -----*****/
message {
    expand:           false;
    padding:          12px 22px 0px 22px;
    background-color: transparent;
}

textbox {
    font:             "FiraCode Nerd Font 10";
    text-color:       @dim;
    background-color: transparent;
}

/*****----- Rows -----*****/
listview {
    lines:            7;
    fixed-height:     false;
    scrollbar:        false;
    padding:          8px 10px 10px 10px;
    spacing:          2px;
    background-color: transparent;
}

element {
    padding:          10px 14px;
    spacing:          12px;
    border-radius:    10px;
    background-color: transparent;
    text-color:       @muted;
    cursor:           pointer;
}

element selected.normal {
    background-color: @hover;
    text-color:       @foreground;
}

element.normal.active   { text-color: @dim; }
element selected.active { background-color: @hover; text-color: @accent; }

element-icon {
    enabled:          true;
    size:             1.2em;
    background-color: transparent;
}

element-text {
    font:             "FiraCode Nerd Font 12";
    background-color: transparent;
    text-color:       inherit;
    highlight:        @accent;
    vertical-align:   0.5;
    cursor:           inherit;
}

/*****----- Key hints -----*****/
box-footer {
    expand:           false;
    orientation:      horizontal;
    padding:          10px 16px;
    spacing:          8px;
    background-color: transparent;
    border:           1px 0px 0px 0px;
    border-color:     @divider;
    children:         [ textbox-k1, textbox-l1, textbox-k2, textbox-l2, textbox-gap, textbox-k4 ];
}

textbox-k1, textbox-k2, textbox-k4 {
    font:             "FiraCode Nerd Font 9";
    text-color:       @muted;
    background-color: @surface;
    border-radius:    6px;
    padding:          3px 7px;
    expand:           false;
    vertical-align:   0.5;
}

textbox-l1, textbox-l2 {
    font:             "FiraCode Nerd Font 9";
    text-color:       @dim;
    background-color: transparent;
    expand:           false;
    vertical-align:   0.5;
    margin:           0px 6px 0px 0px;
}

textbox-k1  { content: "↑↓"; }
textbox-l1  { content: "move"; }
textbox-k2  { content: "↵"; }
textbox-l2  { content: "select"; }
textbox-gap { content: ""; expand: true; background-color: transparent; }
textbox-k4  { content: "esc"; }

/*****----- No extras -----*****/
prompt         { enabled: false; }
case-indicator { enabled: false; }
mode-switcher  { enabled: false; }

mainbox {
    padding:          0px;
    spacing:          0px;
    background-color: transparent;
    children:         [ inputbar, message, listview, box-footer ];
}

/*****----- Search -----*****/
inputbar {
    expand:           false;
    padding:          16px 18px;
    spacing:          12px;
    background-color: transparent;
    border:           0px 0px 1px 0px;
    border-color:     @divider;
    children:         [ textbox-prompt, entry, textbox-esc ];
}

textbox-prompt {
    content:          " ";
    font:             "FiraCode Nerd Font 14";
    text-color:       @accent;
    background-color: transparent;
    expand:           false;
    vertical-align:   0.5;
}

entry {
    placeholder:      "application name";
    placeholder-color: @dim;
    text-color:       @foreground;
    background-color: transparent;
    vertical-align:   0.5;
    cursor:           text;
}

textbox-esc {
    content:          "drun";
    font:             "FiraCode Nerd Font 9";
    text-color:       @muted;
    background-color: transparent;
    border:           1px;
    border-color:     @border-colour;
    border-radius:    7px;
    padding:          4px 8px;
    expand:           false;
    vertical-align:   0.5;
}
