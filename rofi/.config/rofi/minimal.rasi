@theme "hybrid.rasi"

configuration {
    sort: true;
    modi:                "drun";
    show-icons:          false;
    display-drun:        "";
    text-color:       @accent;
    drun-display-format: "{icon} {name}";
    font:                "FiraCode Nerd Font 12";
    terminal:            "/usr/bin/ghostty";
}

window {
    width:            350px;
    // height:           350px;
    background-color: @background;
    border-radius:    16px;
    border-color:     @border-colour;
    border:           2px;
    location:         north;
    anchor:           north;
    y-offset:         0px;
}

mainbox {
    padding:          16px 0px;
    spacing:          0px;
    background-color: transparent;
}

/*****----- Input -----*****/
inputbar {
    spacing:          0px;
    padding:          0px 24px 16px 24px;
    background-color: transparent;
    border:           0px 0px 0px 0px;
    border-color:     @border-colour;
    children:         [ textbox-prompt ,entry ];
}

prompt {
    enabled:          false;
}

case-indicator {
    enabled:          false;
}

textbox-prompt {
    content:          " ";
    font:             "FiraCode Nerd Font 13";
    text-color:       @accent;
    background-color: transparent;
    expand:           false;
    margin:           7px 5px 0px 0px;
}

entry {
    placeholder:      "application name";
    placeholder-color: @dim;
    background-color: transparent;
    text-color:       @accent;
    padding: 5 0 0 6;
    font:             "FiraCode Nerd Font 13";
    cursor:           text;
    border:           0px;
}

/*****----- List -----*****/
listview {
    spacing:          0px;
    padding:          12px 16px 0px 16px;
    background-color: transparent;
    scrollbar:        false;
    lines:            6;
    // fixed-height:     true;
    fixed-height:     false;
    no-fixed-num-lines: false;
}

element {
    padding:          9px 0px 8px 15px;
    spacing:          0px;
    border:           0px;
    border-radius:    8px;
    background-color: transparent;
    text-color:       @muted;
    cursor:           pointer;
}

element-icon {
    enabled:          true;
    size: 2ch;
}

element-text {
    background-color: transparent;
    text-color:       inherit;
    highlight:        @accent;
    cursor:           inherit;
    font:             "FiraCode Nerd Font 13";
}

element.selected.normal {
    background-color: @hover;
    text-color:       @foreground;
    highlight:        @foreground;
}

element.normal.active {
    text-color:       @dim;
    highlight:        @dim;
}

element.selected.active {
    background-color: @hover;
    text-color:       @accent;
    highlight:        @accent;
}

mode-switcher {
    enabled:          false;
}

message {
    enabled:          false;
}
