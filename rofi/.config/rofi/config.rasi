@theme "hybrid.rasi"

configuration {
    sort: true;
    modi: "drun,run,window,filebrowser";
    show-icons: true;
    icon-theme: "Tela";
    display-drun: "  ";
    drun-display-format: "{icon} {name}";
    location: 2;
    font: "FiraCode Nerd Font 13";
    terminal: "/usr/bin/ghostty";
    // matching: "fuzzy";
    // sort-method: "fzf";
}

window {
    width: 350px;
    height: 350px;
    background-color: @background;
    border-radius: 16px;
    border-color: @border-colour;
    border: 2px;
}

/*****----- Elements -----*****/
element {
    enabled:                     true;
    spacing:                     10px;
    padding-left:               10px;
    border:                      0px solid;
    border-radius:               8px;
    border-color:                @border-color;
    background-color:            transparent;
    text-color:                  @foreground-color;
    cursor:                      pointer;
}

element-icon {
    text-color:                  inherit;
    cursor:                      inherit;
    size: 2ch;
    // size: 2.95;
}
element-text {
    text-color:                  inherit;
    highlight:                   inherit;
    cursor:                      inherit;
}

button.selected {
    background-color: @selected-normal-background;
}

element.normal.active {
    text-color:       @active-foreground;
}
element.selected.normal {
    text-color:       @accent;
}

inputbar {
    spacing: 0px;
    padding: 12px 16px;
    border-radius: 8px;
    background: @surface;
}

entry {
    placeholder: "";
    background: @surface;
    text-color: @foreground;
    padding: 0px 0px 0px 12px;
}

listview {
    spacing:      2px ;
    padding:      0px 20px 10px 20px;
}
