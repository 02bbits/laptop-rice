@theme "hybrid.rasi"

configuration {
    sort: true;
    modi:                "drun";
    show-icons:          false;
    display-drun:        "";
    drun-display-format: "{name}";
    font:                "FiraCode Nerd Font 13";
    terminal:            "/usr/bin/ghostty";
}

window {
    width:            350px;
    // height:           350px;
    background-color: @background;
    border-radius:    16px;
    border-color:     @border-colour;
    border:           2px;
    location:         north;
    anchor:           north;
    y-offset:         0px;
}

mainbox {
    padding:          16px 0px;
    spacing:          0px;
    background-color: transparent;
    children: [listview];
}


entry {
    enabled: false;
}

/*****----- Input -----*****/
prompt {
    enabled:          false;
}

case-indicator {
    enabled:          false;
}

inputbar {
  enabled: false;
}
/*****----- List -----*****/
listview {
    spacing:          0px;
    padding:          12px 16px 0px 16px;
    background-color: transparent;
    scrollbar:        false;
    fixed-height:     false;
    no-fixed-num-lines: false;
}

element {
    padding:          9px 0px 8px 15px;
    spacing:          0px;
    border:           0px;
    border-radius:    8px;
    background-color: transparent;
    text-color:       @muted;
    cursor:           pointer;
}

element-icon {
    enabled:          false;
    size:             0px;
}

element-text {
    background-color: transparent;
    text-color:       inherit;
    highlight:        @accent;
    cursor:           inherit;
    font:             "FiraCode Nerd Font 13";
}

element.selected.normal {
    background-color: @hover;
    text-color:       @foreground;
    highlight:        @foreground;
}

element.normal.active {
    text-color:       @dim;
    highlight:        @dim;
}

element.selected.active {
    background-color: @hover;
    text-color:       @accent;
    highlight:        @accent;
}

mode-switcher {
    enabled:          false;
}

message {
    enabled:          false;
}
