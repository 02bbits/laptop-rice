@theme "hybrid.rasi"

configuration {
    sort: true;
    modi:                "drun";
    show-icons:          false;
    display-drun:        "";
    drun-display-format: "{name}";
    font:                "FiraCode Nerd Font 13";
    terminal:            "/usr/bin/ghostty";
}

window {
    width:            500px;
    // height:           350px;
    background-color: @background;
    border-radius:    20px;
    border-color:     #2a2a2a;
    border:           2px;
    location:         north;
    anchor:           north;
    y-offset:         0px;
}

mainbox {
    padding:          16px 0px;
    spacing:          0px;
    background-color: transparent;
    children: [listview];
}

prompt {
    enabled:          false;
}

case-indicator {
    enabled:          false;
}

/*****----- List -----*****/
listview {
    spacing:          0px;
    padding:          12px 16px 0px 16px;
    background-color: transparent;
    scrollbar:        false;
    lines:            12;
    // fixed-height:     true;
    fixed-height:     false;
    no-fixed-num-lines: false;
}

element {
    padding:          9px 0px 8px 15px;
    spacing:          0px;
    border:           0px;
    border-radius:    6px;
    background-color: transparent;
    text-color:       #919191;
    cursor:           pointer;
}

element-icon {
    enabled:          false;
    size:             0px;
}

element-text {
    background-color: transparent;
    text-color:       inherit;
    highlight:        inherit;
    cursor:           inherit;
    font:             "FiraCode Nerd Font 13";
}

element.selected.normal {
    background-color: #2a2a2a;
    text-color:       #e2e2e2;
}

element.normal.active {
    text-color:       #474747;
}

element.selected.active {
    background-color: #2a2a2a;
    text-color:       #b01949;
}

mode-switcher {
    enabled:          false;
}

message {
    enabled:          false;
}
