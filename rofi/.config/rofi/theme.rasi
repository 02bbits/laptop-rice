/* Ink — shared base for every rofi menu. Mirrors colors.toml.
   Child themes import this with @theme "theme.rasi" and should
   reference these names, not raw hex. */

* {
    /* Surfaces */
    background:       #020305;
    surface:          #0e0e0e;
    hover:            #1b1b1b;

    /* Lines */
    border-colour:    #2a2a2a;
    divider:          #1f1f1f;

    /* Text */
    foreground:       #f0ebd8;
    muted:            #a8a8a8;
    dim:              #6a6a6a;

    /* Accent — selected item only */
    accent:           #b01949;

    /* Aliases rofi's own widgets expect */
    background-color:            @background;
    foreground-color:            @muted;
    border-color:                @border-colour;
    background-alt:              @surface;
    selected:                    @accent;
    active:                      @muted;
    urgent:                      @accent;

    normal-background:           transparent;
    normal-foreground:           @muted;
    selected-normal-background:  @hover;
    selected-normal-foreground:  @foreground;
    active-background:           transparent;
    active-foreground:           @dim;
    selected-active-background:  @hover;
    selected-active-foreground:  @accent;
    urgent-background:           transparent;
    urgent-foreground:           @accent;
    selected-urgent-background:  @hover;
    selected-urgent-foreground:  @accent;
}

prompt {
    enabled:          true;
    background-color: inherit;
    text-color:       inherit;
}

textbox-prompt-colon {
    enabled:          true;
    padding:          5px 0px;
    expand:           false;
    str:              "";
    background-color: inherit;
    text-color:       @accent;
}

entry {
    enabled:            true;
    padding:            5px 0px;
    cursor:             text;
    placeholder-color:  @dim;
}

num-filtered-rows,
num-rows,
textbox-num-sep,
case-indicator {
    enabled:          true;
    expand:           false;
    background-color: inherit;
    text-color:       @dim;
}

textbox-num-sep { str: "/"; }

window {
    background-color: @background;
    border-radius:    0px;
}

element {
    border-radius:    0px;
}
