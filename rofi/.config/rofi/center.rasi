@theme "hybrid.rasi"

configuration {
    show-icons:          false;
    font:                "FiraCode Nerd Font 13";
}

window {
    width:            450px;
    background-color: @background;
    border-radius:    16px;
    border-color:     @border-colour;
    border:           2px;
    location:         north;
    anchor:           north;
    padding:          0px;
    y-offset:         0px;
}

mainbox {
    padding:          0px;
    spacing:          0px;
    background-color: transparent;
    children:         [inputbar, listview ];
}

textbox-status {
    content:          "esc to close";
    font:             "FiraCode Nerd Font 9";
    text-color:       @border-colour;
    background-color: transparent;
    expand:           false;
    horizontal-align: 1;
    vertical-align:   0.5;
}

/*****----- Input -----*****/
inputbar {
    spacing:          0px;
    padding:          14px 20px;
    background-color: @surface;
    border:           0px 0px 1px 0px;
    border-color:     @divider;
    children:         [ textbox-prompt, entry, textbox-status ];
}

textbox-prompt {
    content:          " ";
    font:             "FiraCode Nerd Font 13";
    text-color:       @accent;
    background-color: transparent;
    expand:           false;
    horizontal-align: 0.5;
    vertical-align:   0.5;
    margin:           0px 10px 0px 0px;
}

entry {
    placeholder:      "command name";
    placeholder-color: @dim;
    background-color: transparent;
    text-color:       @accent;
    padding:          7px;
    font:             "FiraCode Nerd Font 13";
    // cursor:           text;
    border:           0px;
    vertical-align:   0.5;
}

/*****----- List -----*****/
listview {
    spacing:          0px;
    padding:          8px 12px 12px 12px;
    background-color: transparent;
    scrollbar:        false;
    lines:            8;
    fixed-height:     false;
    columns:          2;
}

element {
    padding:          9px 0px 8px 15px;
    spacing:          0px;
    border:           0px;
    border-radius:    8px;
    background-color: transparent;
    text-color:       @muted;
    cursor:           pointer;
}

element-icon {
    enabled:          false;
    size:             0px;
}

element-text {
    background-color: transparent;
    text-color:       inherit;
    highlight:        @accent;
    cursor:           inherit;
    font:             "FiraCode Nerd Font 13";
}

element.selected.normal {
    background-color: @hover;
    text-color:       @foreground;
    highlight:        @foreground;
}

element.normal.active {
    text-color:       @dim;
    highlight:        @dim;
}

element.selected.active {
    background-color: @hover;
    text-color:       @accent;
    highlight:        @accent;
}

/*****----- No extras -----*****/
mode-switcher { enabled: false; }
message       { enabled: false; }
prompt        { enabled: false; }
