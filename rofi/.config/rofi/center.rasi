@theme "theme.rasi"

configuration {
    show-icons:          true;
    font:                "FiraCode Nerd Font 12";
    icon-theme: "Breeze";
}

window {
    width:            350px;
    background-color: @background;
    border:           2px;
    location:         north;
    anchor:           north;
    padding:          0px;
    y-offset:         0px;
}

mainbox {
    padding:          0px;
    spacing:          0px;
    background-color: transparent;
    children:         [inputbar, listview ];
}

textbox-status {
    content:          "execute scripts";
    font:             "FiraCode Nerd Font 9";
    text-color:       @dim;
    border-color:       @border-colour;
    padding: 0px 8px 0px 8px;
    background-color: transparent;
    border: 1px;
    expand:           false;
    horizontal-align: 1;
    vertical-align:   0.5;
}

/*****----- Input -----*****/
inputbar {
    spacing:          0px;
    padding:          14px 20px;
    background-color: @background;
    // border:           0px 0px 1px 0px;
    border-color:     @divider;
    children:         [ textbox-prompt, entry, textbox-status ];
}

textbox-prompt {
    content:          "  ";
    font:             "FiraCode Nerd Font 13";
    text-color:       @accent;
    background-color: transparent;
    expand:           false;
    margin:           7px 5px 0px 0px;
}

entry {
    placeholder:      "/command";
    placeholder-color: @dim;
    background-color: transparent;
    text-color:       @accent;
    padding:          7px;
    font:             "FiraCode Nerd Font 13";
    // cursor:           text;
    border:           0px;
    vertical-align:   0.5;
}

/*****----- List -----*****/
listview {
    spacing:          0px;
    padding:          12px;
    background-color: transparent;
    scrollbar:        false;
    lines:            7;
    fixed-height:     false;
    columns:          1;
}

element {
    padding:          10px;
    spacing:          0px;
    border:           0px;
    background-color: transparent;
    text-color:       @muted;
    cursor:           pointer;
}

element-icon {
    enabled:          false;
    size:             20px;
}

element-text {
    background-color: transparent;
    horizontal-align: 0.05;
    text-color:       inherit;
    highlight:        @accent;
    cursor:           inherit;
    font:             "FiraCode Nerd Font 13";
}

element.selected.normal {
    background-color: @hover;
    text-color:       @foreground;
    highlight:        @foreground;
}

element.normal.active {
    text-color:       @dim;
    highlight:        @dim;
}

element.selected.active {
    background-color: @hover;
    text-color:       @accent;
    highlight:        @accent;
}

/*****----- No extras -----*****/
mode-switcher { enabled: false; }
message       { enabled: false; }
prompt        { enabled: false; }
