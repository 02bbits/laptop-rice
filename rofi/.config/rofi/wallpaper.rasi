@theme "theme.rasi"

configuration {
    show-icons:          true;
    icon-theme:          "hicolor";
    display-drun:        "";
    font:                "FiraCode Nerd Font 11";
}

window {
    width:            1600px;
    border-color:     @divider;
    border:           1px;
    location:         center;
    anchor:           center;
    padding:          0px;
}

mainbox {
    padding:          20px;
    spacing:          0px;
    background-color: transparent;
    children:         [ listview ];
}

/*****----- List -----*****/
listview {
    spacing:          10px;
    padding:          0px;
    background-color: transparent;
    scrollbar:        false;
    fixed-height:     true;
    lines:            1;
    columns:          5;
    cycle:            true;
}

element {
    padding:          0px;
    spacing:          0px;
    border:           2px;
    border-radius:    16px;
    border-color:     transparent;
    background-color: @surface;
    cursor:           pointer;
    orientation:      vertical;
}

element-icon {
    size:             69%;
    background-color: transparent;
    cursor:           inherit;
}

element-text {
    enabled:          false;
    size:             0px;
}

element.selected.normal {
    border-color:     @accent;
    background-color: @divider;
}

element.normal.normal {
    border-color:     @border-colour;
}

/*****----- No extras -----*****/
inputbar    { enabled: false; }
prompt      { enabled: false; }
entry       { enabled: false; }
mode-switcher { enabled: false; }
message     { enabled: false; }
