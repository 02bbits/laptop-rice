@theme "hybrid.rasi"

configuration {
    show-icons:          true;
    icon-theme:          "hicolor";
    display-drun:        "";
    font:                "FiraCode Nerd Font 11";
}

window {
    width:            1600px;
    background-color: #0e0e0e;
    border-radius:    20px;
    border-color:     #1f1f1f;
    border:           1px;
    location:         center;
    anchor:           center;
    padding:          0px;
}

mainbox {
    padding:          20px;
    spacing:          0px;
    background-color: transparent;
    children:         [ listview ];
}

/*****----- List -----*****/
listview {
    spacing:          10px;
    padding:          0px;
    background-color: transparent;
    scrollbar:        false;
    fixed-height:     true;
    lines:            1;
    columns:          5;
    cycle:            true;
}

element {
    padding:          0px;
    spacing:          0px;
    border:           2px;
    border-radius:    20px;
    border-color:     transparent;
    background-color: #131313;
    cursor:           pointer;
    orientation:      vertical;
}

element-icon {
    size:             69%;
    background-color: transparent;
    cursor:           inherit;
}

element-text {
    enabled:          false;
    size:             0px;
}

element.selected.normal {
    border-color:     #b01949;
    background-color: #1f1f1f;
}

element.normal.normal {
    border-color:     #2a2a2a;
}

/*****----- No extras -----*****/
inputbar    { enabled: false; }
prompt      { enabled: false; }
entry       { enabled: false; }
mode-switcher { enabled: false; }
message     { enabled: false; }
